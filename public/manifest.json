{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "AI \u7b80\u5386 - \u5c97\u4f4d\u51c6\u5907",
  "version": "2.0.0",
  "description": "\u9009\u4e2d\u5c97\u4f4d\u63cf\u8ff0\uff0c\u751f\u6210\u57fa\u4e8e\u771f\u5b9e\u7ecf\u5386\u7684\u6c42\u804c\u51c6\u5907\u6750\u6599\u3002",
