{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "AI \u7b80\u5386 - \u5c97\u4f4d\u51c6\u5907",
  "version": "2.0.0",
  "description": "\u9009\u4e2d\u5c97\u4f4d\u63cf\u8ff0\uff0c\u751f\u6210\u57fa\u4e8e\u771f\u5b9e\u7ecf\u5386\u7684\u6c42\u804c\u51c6\u5907\u6750\u6599\u3002",
  "permissions": ["activeTab", "contextMenus", "sidePanel", "storage", "identity", "scripting", "tabs"],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://aijianli.tech/*",
    "https://www.aijianli.tech/*",
    "https://*.zhipin.com/*",
    "https://*.51job.com/*",
    "https://*.zhaopin.com/*",
    "https://*.liepin.com/*",
    "https://*.lagou.com/*",
    "https://*.58.com/*",
    "https://*.ganji.com/*",
    "https://*.yingjiesheng.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://*.51job.com/*",
        "https://*.zhaopin.com/*",
        "https://*.liepin.com/*",
        "https://*.lagou.com/*",
        "https://*.58.com/*",
        "https://*.ganji.com/*",
        "https://*.yingjiesheng.com/*"
      ],
      "js": [
        "content/shared.js",
        "content/adapters/structured.js",
        "content/adapters/zhipin.js",
        "content/adapters/51job.js",
        "content/adapters/zhaopin.js",
        "content/adapters/liepin.js",
        "content/adapters/lagou.js",
        "content/adapters/classifieds.js",
        "content/adapters/yingjiesheng.js",
        "content/adapters/generic.js",
        "content/actions.js",
        "content/launcher.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "AI \u7b80\u5386 - \u5c97\u4f4d\u51c6\u5907" }
}
